# Supabase（不填就跑示意資料模式）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Gemini API（訂單辨識）；Google AI Pro 訂閱不含 API 額度，需另外申請金鑰
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# 進榜門檻：至少幾筆購買驗證
NEXT_PUBLIC_MIN_VERIFIED=15
